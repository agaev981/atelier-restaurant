# ================= SECRET KEYS (DO NOT COMMIT) =================
# 1) Create a bot via @BotFather -> /newbot -> copy the token here
TELEGRAM_BOT_TOKEN=
# 2) Your chat_id (write to your bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates -> "chat":{"id": ...})
#    For a channel/group the id is negative, e.g. -1001234567890
TELEGRAM_CHAT_ID=
